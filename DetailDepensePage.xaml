<?xml version="1.0" encoding="utf-8" ?>

<ContentPage
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    x:Class="MauiApp1.DetailDepensePage"
    Title="Détail de la dépense"
    BackgroundColor="#F5F3FF">

    <ScrollView>

        <VerticalStackLayout Padding="25"
                             Spacing="20">

            <!-- Titre -->
            <Label Text="💳 Détail de la dépense"
                   FontSize="28"
                   FontAttributes="Bold"
                   TextColor="#512BD4"
                   HorizontalOptions="Center"
                   Margin="0,10,0,15" />

            <!-- Carte -->
            <Border BackgroundColor="White"
                    Stroke="#DDD6FE"
                    StrokeThickness="2"
                    Padding="22">

                <Border.StrokeShape>
                    <RoundRectangle CornerRadius="20" />
                </Border.StrokeShape>

                <VerticalStackLayout Spacing="18">

                    <!-- Description -->
                    <Label Text="📝 Description"
                           FontSize="16"
                           FontAttributes="Bold"
                           TextColor="#512BD4" />

                    <Label x:Name="DescriptionLabel"
                           FontSize="20"
                           TextColor="#222222" />

                    <BoxView HeightRequest="1"
                             BackgroundColor="#E5E7EB" />

                    <!-- Catégorie -->
                    <Label Text="🏷️ Catégorie"
                           FontSize="16"
                           FontAttributes="Bold"
                           TextColor="#512BD4" />

                    <Label x:Name="CategorieLabel"
                           FontSize="20"
                           TextColor="#222222" />

                    <BoxView HeightRequest="1"
                             BackgroundColor="#E5E7EB" />

                    <!-- Date -->
                    <Label Text="📅 Date"
                           FontSize="16"
                           FontAttributes="Bold"
                           TextColor="#512BD4" />

                    <Label x:Name="DateLabel"
                           FontSize="20"
                           TextColor="#222222" />

                    <BoxView HeightRequest="1"
                             BackgroundColor="#E5E7EB" />

                    <!-- Montant -->
                    <Label Text="💰 Montant"
                           FontSize="16"
                           FontAttributes="Bold"
                           TextColor="#512BD4" />

                    <Label x:Name="MontantLabel"
                           FontSize="24"
                           FontAttributes="Bold"
                           TextColor="#16A34A" />

                </VerticalStackLayout>

            </Border>

            <!-- Retour -->
            <Button Text="← Retour"
                    Clicked="Retour_Clicked"
                    BackgroundColor="#512BD4"
                    TextColor="White"
                    FontSize="18"
                    FontAttributes="Bold"
                    CornerRadius="15"
                    HeightRequest="55" />

        </VerticalStackLayout>

    </ScrollView>

</ContentPage>