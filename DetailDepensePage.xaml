<?xml version="1.0" encoding="utf-8" ?>

<ContentPage
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    x:Class="MauiApp1.DetailDepensePage"
    Title="Détail de la dépense">

    <ScrollView>

        <VerticalStackLayout
            Padding="25"
            Spacing="20">

            <Label
                Text="Détail de la dépense"
                FontSize="28"
                FontAttributes="Bold"
                HorizontalOptions="Center" />

            <Border
                Padding="20"
                StrokeThickness="1">

                <VerticalStackLayout Spacing="10">

                    <Label
                        Text="Dépense sélectionnée"
                        FontSize="18"
                        FontAttributes="Bold" />

                    <Label
                        x:Name="DepenseLabel"
                        FontSize="18" />

                </VerticalStackLayout>

            </Border>

            <Button
                Text="Retour"
                Clicked="Retour_Clicked" />

        </VerticalStackLayout>

    </ScrollView>

</ContentPage>